{
  "appId": "com.heavenbd.app",
  "appName": "HEAVEN",
  "webDir": "www",
  "backgroundColor": "#ffffff",
  "server": {
    "url": "https://heaven-bd.vercel.app",
    "androidScheme": "https",
    "allowNavigation": ["heaven-bd.vercel.app", "*.paymently.io", "*.bkash.com", "*.nagad.com.bd", "*.sslcommerz.com"],
    "errorPath": "offline.html"
  },
  "plugins": {
    "SystemBars": { "insetsHandling": "css", "style": "LIGHT" },
    "SplashScreen": { "launchShowDuration": 5000, "launchAutoHide": true, "launchFadeOutDuration": 300, "backgroundColor": "#ffffff", "showSpinner": false }
  }
}
